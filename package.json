{
  "name": "lobomotor-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/serve.mjs",
    "lint": "eslint src scripts tests *.mjs",
    "test": "playwright test",
    "check": "npm run lint && npm run build && npm run test:static && npm test",
    "test:static": "node --test scripts/check-build.test.mjs scripts/check-contact.test.mjs"
  },
  "dependencies": {
    "framer-motion": "11.11.11",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19"
  }
}
